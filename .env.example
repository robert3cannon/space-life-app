# Postgres connection string (Neon, Vercel Postgres, or local).
# Use the pooled Neon connection string on Vercel. prepare mode is disabled in the app.
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

# UI passcode. This is the only account. Pick a long password.
APP_PASSWORD=change-me

# Signs the session cookie. Use a long random string (openssl rand -base64 32).
SESSION_SECRET=change-me-to-a-long-random-string

# Bearer token for the bot API. Give each bot this same token, or rotate it in one place.
BOT_API_TOKEN=change-me-to-a-long-random-string

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL. Apple and browsers require this.
VAPID_SUBJECT=mailto:you@example.com

# Sent as "Authorization: Bearer <CRON_SECRET>" by Vercel Cron, and by any external scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# Optional. Defaults to Robert.
USER_NAME=Robert

# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup
# Leave blank locally to use the shared DEMO_KEY (tightly rate limited).
USDA_API_KEY=
